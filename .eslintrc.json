{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "ignorePatterns": [
    "client/",
    "node_modules/",
    "**/dist/",
    "build/",
    "server/dist/",
    "*.min.js",
    "test-*.js"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  }
}
